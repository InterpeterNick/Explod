<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>


<FlowPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="xyz.nick.explod.APPLE">
   <children>
      <ImageView fx:id="imag" fitHeight="350.0" fitWidth="446.0" onMouseClicked="#explod" pickOnBounds="true" preserveRatio="true" />
      <Button mnemonicParsing="false" onAction="#explod" text="EXPLOD" />
      <Button mnemonicParsing="false" onAction="#reset" text="RESET" />
   </children>
</FlowPane>
